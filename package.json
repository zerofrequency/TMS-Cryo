{
  "name": "carrier-appointment-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "npm run test:js && npm run test:python",
    "test:js": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "backup:vps-db": "bash scripts/backup-vps-db.sh",
    "check:vps": "bash scripts/check-vps.sh"
  }
}
