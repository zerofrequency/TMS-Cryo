server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name tms.zefanlong.space _;
    root /var/www/tms/current;
    index index.html;

    location = /login.html {
        add_header Cache-Control "no-store, max-age=0" always;
        expires off;
        try_files $uri =404;
    }

    location /auth/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /rest/v1/ {
        if ($cookie_tms_session != "__TMS_SESSION_TOKEN__") {
            return 302 /login.html;
        }
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /documents/ {
        if ($cookie_tms_session != "__TMS_SESSION_TOKEN__") {
            return 302 /login.html;
        }
        client_max_body_size 20m;
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /tms-config.js {
        if ($cookie_tms_session != "__TMS_SESSION_TOKEN__") {
            return 302 /login.html;
        }
        add_header Cache-Control "no-store, max-age=0" always;
        expires off;
        try_files $uri =404;
    }

    location = /map-config.js {
        if ($cookie_tms_session != "__TMS_SESSION_TOKEN__") {
            return 302 /login.html;
        }
        add_header Cache-Control "no-store, max-age=0" always;
        expires off;
        try_files $uri =404;
    }

    location ~* \.(?:css|js|json|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$ {
        if ($cookie_tms_session != "__TMS_SESSION_TOKEN__") {
            return 302 /login.html;
        }
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public";
    }

    location / {
        if ($cookie_tms_session != "__TMS_SESSION_TOKEN__") {
            return 302 /login.html;
        }
        try_files $uri $uri/ =404;
    }
}
